<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="spreadsheet_dashboard_group_membership"
        model="spreadsheet.dashboard.group"
    >
        <field name="name">Membership</field>
    </record>

    <record id="spreadsheet_dashboard_membership" model="spreadsheet.dashboard">
        <field name="name">Acquisition</field>
        <field
            name="spreadsheet_binary_data"
            type="base64"
            file="spreadsheet_dashboard_membership/data/files/membership_dashboard.json"
        />
        <field
            name="main_data_model_ids"
            eval="[(4, ref('membership.model_membership_membership_line'))]"
        />
        <field
            name="sample_dashboard_file_path"
        >spreadsheet_dashboard_membership/data/files/membership_sample_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_membership" />
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field name="sequence">100</field>
        <field name="is_published">True</field>
    </record>

    <record
        id="spreadsheet_dashboard_membership_activity"
        model="spreadsheet.dashboard"
    >
        <field name="name">Activity</field>
        <field
            name="spreadsheet_binary_data"
            type="base64"
            file="spreadsheet_dashboard_membership/data/files/membership_activities_dashboard.json"
        />
        <field
            name="main_data_model_ids"
            eval="[(4, ref('membership.model_membership_membership_line'))]"
        />
        <field
            name="sample_dashboard_file_path"
        >spreadsheet_dashboard_membership/data/files/membership_sample_activities_dashboard.json</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_membership" />
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field name="sequence">200</field>
        <field name="is_published">True</field>
    </record>
</odoo>
