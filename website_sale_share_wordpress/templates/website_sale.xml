<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="product_share_buttons"
        inherit_id="website_sale.product_share_buttons"
    >
        <xpath expr="//a[hasclass('s_share_email')]" position="before">
            <a
                t-if="not _exclude_share_links or not 'wordpress' in _exclude_share_links"
                href="/share/getDomain?url={url}&amp;media={media}&amp;title={title}&amp;platform=wordpress"
                class="s_share_wordpress"
                target="_blank"
                aria-label="Wordpress"
            >
                <img
                    src="/website_sale_share_wordpress/static/img/icons/wordpress.svg"
                    class="fa social-media-icon rounded shadow-sm"
                    alt="social-media-icon"
                />
            </a>
        </xpath>
    </template>

    <record id="s_share_000_scss" model="ir.asset">
        <field name="name">Share Wordpress 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field
            name="path"
        >website_sale_share_wordpress/static/src/snippets/s_share/000.scss</field>
    </record>
</odoo>
