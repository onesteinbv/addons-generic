<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_share_buttons" inherit_id="website_sale.product_share_buttons">
        <xpath expr="//a[hasclass('s_share_email')]" position="before">
            <a t-if="not _exclude_share_links or not 'blogger' in _exclude_share_links" href="https://www.blogger.com/blog-this.g?u={url}&amp;n={title}" aria-label="Blogger" class="s_share_blogger" target="_blank">
                <img src="/website_sale_share_blogger/static/img/icons/blogger.svg" class="fa social-media-icon rounded shadow-sm" alt="social-media-icon"/>
            </a>
        </xpath>
    </template>

    <record id="s_share_000_scss" model="ir.asset">
        <field name="name">Share Blogger 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">website_sale_share_blogger/static/src/snippets/s_share/000.scss</field>
    </record>

</odoo>
