<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="partner_detail" inherit_id="website_partner.partner_detail">
        <xpath expr="//h1[@t-field='partner.display_name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-esc">partner</attribute>
            <attribute name="t-options">{"widget": "contact","fields": ["name"]}</attribute>
        </xpath>
    </template>
</odoo>
