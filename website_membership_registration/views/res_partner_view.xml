<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="membership_email_verification_status" readonly="1" />
            </xpath>
            <xpath expr="//field[@name='free_member']" position="after">
                <field name="membership_application_date" />
            </xpath>
            <xpath expr="//field[@name='member_lines']" position="before">
                <group name="website_description">
                    <field name="website_description" string="Bio" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="membership_members_tree" model="ir.ui.view">
        <field name="inherit_id" ref="membership.membership_members_tree" />
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="display_name" />
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_member_filter" model="ir.ui.view">
        <field name="inherit_id" ref="membership.view_res_partner_member_filter" />
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute
                    name="filter_domain"
                >['|', '|', '|', '|', '|',('name', 'ilike', self), ('display_name', 'ilike', self), ('ref', '=', self), ('email', 'ilike', self), ('vat', 'ilike', self), ('company_registry', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute
                    name="filter_domain"
                >['|', '|', '|', '|', '|',('name', 'ilike', self), ('display_name', 'ilike', self), ('ref', '=', self), ('email', 'ilike', self), ('vat', 'ilike', self), ('company_registry', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
