<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <div name="memebership_settings" invisible="not website_id">
                    <h2>Membership</h2>
                    <div
                        class="row mt16 o_settings_container"
                        id="website_membership_registration"
                    >
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="allow_membership_registration" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="allow_membership_registration" />
                                <div class="text-muted">
                                    Show a form on the website which allows user to become member.
                                </div>

                                <div
                                    class="content-group"
                                    invisible="not allow_membership_registration"
                                >
                                    <div class="mt16 row">
                                        <label
                                            for="cleanup_unverified_members_days"
                                            class="col-3 col-lg-3 o_light_label"
                                        />
                                        <field
                                            name="cleanup_unverified_members_days"
                                            class="oe_inline"
                                            required="allow_membership_registration"
                                        />
                                    </div>
                                </div>

                                <div
                                    class="content-group"
                                    invisible="not allow_membership_registration"
                                >
                                    <div class="mt16 row">
                                        <label
                                            for="membership_job_id"
                                            class="col-3 col-lg-3 o_light_label"
                                        />
                                        <field
                                            name="membership_job_id"
                                            class="oe_inline"
                                        />
                                    </div>
                                </div>

                                <div
                                    class="content-group"
                                    invisible="not allow_membership_registration"
                                >
                                    <div class="mt16">
                                        <a
                                            href="/membership-registration"
                                            target="_blank"
                                            class="oe_link"
                                        >
                                            <i class="fa fa-arrow-right me-1" />
                                            Membership Registration Form
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
