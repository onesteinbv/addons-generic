<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <template id="membership_group_page">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="title" />
            <div id="wrap">
                <div class="oe_structure" id="oe_structure_website_group_1"/>
                <div class="container" name="membership_page">
                    <div class="row" name="description_row">
                        <h3 class="col-lg-12 text-center" id="membership_group_name" t-field="membership_group.name"/>
                        <div class="col-lg-4">
                            <div t-field="membership_group.image" t-options='{"widget": "image", "class": "d-block mx-auto mb16"}'/>
                        </div>
                        <div class="col-lg-8 mt32">
                            <t t-if="membership_group">
                                <div t-field="membership_group.website_top"/>
                                <div t-field="membership_group.website_bottom"/>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="container mt16">
                    <div class="row o_web_membership_group_members_list_container">
                        <t t-set="current_members" t-value="membership_group.membership_group_member_ids.filtered(lambda m:m.state=='current'"/>
                        <div class="col-lg-4 col-md-4 mb48">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="card card-body bg-light">
                                        <div class="o_web_membership_group_committee_member">
                                            <h4>Committee Members:</h4>
                                                <t t-set="committee_members"
                                                   t-value="current_members.filtered(lambda m:m.type=='committee')"/>
                                                <t t-if="committee_members">
                                                    <div class="col-lg-6" t-foreach="committee_members" t-as="committee_member">
                                                        <t t-set="partner" t-value="committee_member.partner_id"/>
                                                        <div class="o_web_membership_group_member mb-3 align-items-center d-flex">
                                                        <img
                                                                class="me-4 rounded-2"
                                                                t-att-src="image_data_uri(partner.user_id.image_128 or partner.avatar_128)"
                                                                alt="Member"
                                                                height="48" width="48"
                                                                style="border: solid 1px #ccc;"
                                                        />
                                                        <t t-if="partner.website_published">
                                                            <a t-attf-href="/partners/#{slug(partner)}">
                                                                <span t-esc="partner"
                                                                      t-options='{"widget": "contact","fields": ["name"]}'/>
                                                            </a>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-esc="partner"
                                                                  t-options='{"widget": "contact","fields": ["name"]}'/>
                                                        </t>
                                                        </div>
                                                    </div>
                                                </t>
                                                <h5 t-else="">No Committee Member found.</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-8 col-md-8 mb48">
                            <div class="row o_web_membership_group_members_list">
                                <div class="col-lg-12">
                                    <h4>Team Members</h4>
                                </div>
                                <t t-set="members" t-value="current_members.filtered(lambda m:m.type!='committee')" />
                                <t t-if="members">
                                    <div class="col-lg-6" t-foreach="members" t-as="member">
                                        <t t-set="partner" t-value="member.partner_id"/>
                                        <div class="o_web_membership_group_member mb-3 align-items-center d-flex">
                                            <img
                                                class="me-4 rounded-2"
                                                t-att-src="image_data_uri(partner.image_128 or partner.avatar_128)"
                                                alt="Member"
                                                height="48" width="48"
                                                style="border: solid 1px #ccc;"
                                            />
                                            <t t-if="partner.website_published">
                                                <a t-attf-href="/members/#{slug(partner)}">
                                                    <t t-esc="partner.display_name" />
                                                </a>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="partner.display_name" />
                                            </t>
                                        </div>
                                    </div>
                                </t>
                                <h5 t-else="" class="col-lg-6">
                                    No member found.
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="oe_structure" id="oe_structure_website_membership_group_2" />
            </div>
        </t>
    </template>

</odoo>
