<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='mail_alias_domain']" position="replace">
            </xpath>
            <xpath expr="//div[@id='email_servers_setting']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <div class="text-muted col-md-12">
                            Use different domains for your mail aliases
                        </div>
                        <div class="mt16" id="mail_alias_domain" dir="ltr">
                            <span>@</span>
                            <field name="alias_domain_id" placeholder="e.g. domain.com"
                                   options="{'no_create_edit': True}"/>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
