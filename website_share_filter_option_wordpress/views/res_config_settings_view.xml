<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_form_view" model="ir.ui.view" >
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_share_filter_option_technical.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='social_media_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="setting_website_share_wordpress">
                    <div class="o_setting_left_pane">
                        <field name="website_share_wordpress"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label string="Wordpress" for="website_share_wordpress"/>
                        <span class="fa fa-lg fa-globe" title="Values set here are website-specific." groups="website.group_multi_website"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
