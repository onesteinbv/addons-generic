<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="membership_products_form" model="ir.ui.view">
        <field name="inherit_id" ref="membership.membership_products_form" />
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field name="first_of_period_billing_policy" invisible="membership_type != 'variable'" />
                <field name="subscribable" invisible="membership_type != 'variable'"/>
                <field
                    name="subscription_template_id"
                    invisible="not subscribable"
                    required="subscribable"
                />
            </xpath>
        </field>
    </record>

</odoo>
