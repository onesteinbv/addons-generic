<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="helpdesk_mgmt.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="helpdesk_mgmt" position="inside">
                <block title="Email" name="helpdesk_mgmt_email_settings">
                    <setting
                        name="helpdesk_mgmt_send_email_on_ticket_creation"
                        help="Send email on ticket creation to contact"
                    />
                </block>
            </app>
        </field>
    </record>
</odoo>
