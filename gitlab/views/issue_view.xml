<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="issue_form" model="ir.ui.view">
        <field name="model">gitlab.issue</field>
        <field name="arch" type="xml">
            <form string="Gitlab Issue">
                <header>
                    <button name="import_notes" type="object" string="Import Notes"/>
                    <field name="state" readonly="1" widget="statusbar" statusbar_visible="opened,closed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="author_username" />
                        <field name="url" widget="url" />
                        <field name="created_at" />
                        <field name="project_id" />
                        <field name="note_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="issue_list" model="ir.ui.view">
        <field name="model">gitlab.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="author_username" />
                <field name="url" widget="url" />
                <field name="created_at" />
                <field name="project_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="issue_action" model="ir.actions.act_window">
        <field name="name">Gitlab Issues</field>
        <field name="res_model">gitlab.issue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
