<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="note_form" model="ir.ui.view">
        <field name="model">gitlab.note</field>
        <field name="arch" type="xml">
            <form string="Gitlab Note">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="author_username" />
                        <field name="created_at" />
                        <field name="project_id" />
                        <field name="url" widget="url" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="note_list" model="ir.ui.view">
        <field name="model">gitlab.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="author_username" />
                <field name="created_at" />
                <field name="project_id" />
                <field name="url" widget="url" />
            </list>
        </field>
    </record>

    <record id="note_action" model="ir.actions.act_window">
        <field name="name">Gitlab Notes</field>
        <field name="res_model">gitlab.note</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
