<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="merge_request_form" model="ir.ui.view">
        <field name="model">gitlab.merge.request</field>
        <field name="arch" type="xml">
            <form string="Gitlab Merge Request">
                <header>
                    <button name="import_notes" type="object" string="Import Notes"/>
                    <button name="import_approvals" type="object" string="Import Approvals"/>
                    <field name="state" readonly="1" widget="statusbar" statusbar_visible="opened,closed,merged,locked"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="author_username" />
                        <field name="url" widget="url" />
                        <field name="created_at" />
                        <field name="project_id" />
                        <field name="note_ids" />
                        <field name="approval_ids">
                            <list>
                                <field name="approver_username" />
                                <field name="approved_at" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="merge_request_list" model="ir.ui.view">
        <field name="model">gitlab.merge.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="author_username" />
                <field name="url" widget="url" />
                <field name="created_at" />
                <field name="project_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="merge_request_action" model="ir.actions.act_window">
        <field name="name">Gitlab Merge Requests</field>
        <field name="res_model">gitlab.merge.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
