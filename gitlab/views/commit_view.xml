<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="commit_form" model="ir.ui.view">
        <field name="model">gitlab.commit</field>
        <field name="arch" type="xml">
            <form string="Gitlab Commit">
                <sheet>
                    <group>
                        <field name="project_id" />
                        <field name="external_id" />
                        <field name="message" />
                        <field name="author_name" />
                        <field name="author_email" />
                        <field name="committed_date" />
                        <field name="url" widget="url" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="commit_list" model="ir.ui.view">
        <field name="model">gitlab.commit</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id" />
                <field name="external_id" />
                <field name="message" />
                <field name="author_name" />
                <field name="author_email" />
                <field name="committed_date" />
                <field name="url" widget="url" />
            </list>
        </field>
    </record>

    <record id="commit_action" model="ir.actions.act_window">
        <field name="name">Gitlab Commits</field>
        <field name="res_model">gitlab.commit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
