<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_share_buttons" inherit_id="website_sale.product_share_buttons">
        <xpath expr="//a[hasclass('s_share_email')]" position="before">
            <a t-if="not _exclude_share_links or not 'telegram' in _exclude_share_links" href="https://t.me/share/url?url={url}&amp;text={title}" class="s_share_telegram" target="_blank" aria-label="Telegram">
                <img src="/website_sale_share_telegram/static/img/icons/telegram.svg" class="fa social-media-icon rounded shadow-sm" alt="social-media-icon"/>
            </a>
        </xpath>
    </template>

    <record id="s_share_000_scss" model="ir.asset">
        <field name="name">Share Telegram 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">website_sale_share_telegram/static/src/snippets/s_share/000.scss</field>
    </record>

</odoo>
