<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_form_view" model="ir.ui.view" >
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_share_filter_option_technical.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='website_share_pinterest']" position="before">
                <field name="module_website_share_blogger" invisible="1"/>
                <field name="module_website_sale_share_blogger" invisible="1"/>
                <setting id="website_share_blogger" invisible="not module_website_share_blogger and not module_website_sale_share_blogger">
                    <field name="website_share_blogger" string="Blogger"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
