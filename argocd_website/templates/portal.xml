<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="portal_breadcrumbs"
        inherit_id="portal.portal_breadcrumbs"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'Applications'"
                t-attf-class="breadcrumb-item #{'active ' if not app else ''}"
            >
                <a
                    t-if="app"
                    t-attf-href="/my/applications?{{ keep_query() }}"
                >Applications</a>
                <t t-else="">Applications</t>
            </li>
            <li t-if="app" class="breadcrumb-item active">
                <t t-esc="app.name" />
            </li>

            <li
                t-if="page_name == 'Customers'"
                t-attf-class="breadcrumb-item #{'active ' if not customer else ''}"
            >
                <a
                    t-if="customer or mode in ['create']"
                    t-attf-href="/my/customers?{{ keep_query() }}"
                >Customers</a>
                <t t-else="">Customers</t>
            </li>
            <li t-if="customer and mode != 'edit'" class="breadcrumb-item active">
                <t t-esc="customer.name" />
            </li>
            <li t-if="customer and mode == 'edit'" class="breadcrumb-item">
                <a t-attf-href="/my/customers/{{ customer.id }}">
                    <t t-esc="customer.name" />
                </a>
            </li>
            <li t-if="mode == 'edit'" class="breadcrumb-item active">
                Edit
            </li>
            <li t-if="mode == 'create'" class="breadcrumb-item active">
                Create Customer
            </li>
        </xpath>
    </template>

    <template
        id="portal_my_home"
        inherit_id="portal.portal_my_home"
        priority="40"
    >
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/argocd_website/static/src/img/application.svg'"/>
                <t t-set="title">Applications</t>
                <t t-set="text">Manage your applications</t>
                <t t-set="url" t-value="'/my/applications'" />
                <t t-set="placeholder_count" t-value="'app_count'" />
            </t>
            <t t-if="request.env.user.partner_id.is_reseller or (request.env.user.partner_id.parent_id and request.env.user.partner_id.parent_id.is_reseller)">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/argocd_website/static/src/img/customer.svg'"/>
                    <t t-set="title">Customers</t>
                    <t t-set="text">Manage your customers</t>
                    <t t-set="url" t-value="'/my/customers'" />
                    <t t-set="placeholder_count" t-value="'customer_count'" />
                </t>
            </t>
        </div>
    </template>

    <template id="external_links_dropdown">
        <t t-set="urls" t-value="app.get_urls()" />
        <t t-if="len(urls) == 1">
            <a t-attf-class="btn #{class}" aria-expanded="false" aria-haspopup="true"
               t-att-href="urls[0][0]" target="_blank" t-attf-title="Open #{urls[0][1]}">
                <i class="fa fa-external-link fa-fw" />
            </a>
        </t>
        <div t-attf-class="dropdown position-static" t-else="">
            <button t-attf-class="btn #{class}" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false" aria-haspopup="true">
                <i class="fa fa-external-link fa-fw" />
            </button>

            <ul class="dropdown-menu">
                <li t-foreach="urls" t-as="url">
                    <a t-att-href="url[0]" target="_blank" t-attf-title="Open #{url[1]}" class="dropdown-item">
                        <t t-esc="url[1]" />
                    </a>
                </li>
            </ul>
        </div>
    </template>

    <template id="actions_dropdown">
        <div t-attf-class="dropdown position-static">
            <button class="btn btn-link" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false" aria-haspopup="true">
                <i class="fa fa-ellipsis-v fa-fw" />
            </button>

            <ul class="dropdown-menu">
                <li>
                    <a t-attf-href="/my/applications/#{app.id}/domain-names" title="Configure Domain Names" class="dropdown-item">
                        <i class="fa fa-globe mr4" />Configure Domain Names
                    </a>
                </li>
            </ul>
        </div>
    </template>


    <template id="portal_my_applications" name="My Applications">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Applications</t>
            </t>
            <t t-if="apps" t-call="portal.portal_table">
                <t t-set="classes" t-value="'mb-2'" />
                <thead>
                    <tr class="active">
                        <th>Name</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="apps" t-as="app">
                        <tr>
                            <td>
                                <a
                                    t-att-href="app.get_portal_url()"
                                    t-att-title="app.name"
                                >
                                    <t t-esc="app.name" />
                                </a>
                            </td>
                            <td>
                                <t t-esc="app.partner_id.display_name" />
                            </td>
                            <td>
                                <div class="js_health_check" t-att-data-app-id="app.id">
                                    <i class="fa fa-circle-o-notch fa-spin fa-fw " />
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-end">
<!--                                    <t t-call="argocd_website.actions_dropdown" /> -->
                                    <t t-call="argocd_website.external_links_dropdown">
                                        <t t-set="class" t-value="'btn-link'" />
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
            <t t-else="">
                <p>You have no applications currently.</p>
            </t>
            <a href="/application/order" class="btn btn-primary">
                Request new application
            </a>
        </t>
    </template>

    <template id="portal_application_page" name="My Application">
        <t t-call="portal.portal_layout">
            <div class="col-12">
                <div class="d-flex">
                    <h2 class="mb-0 flex-fill">
                        <span>
                            Application - <span t-field="app.name" />
                        </span>
                    </h2>
                    <div class="mr4">
                        <button class="btn btn-light" type="button" data-bs-toggle="modal" data-bs-target="#modalUpgrade">
                            <i class="fa fa-angle-double-up fa-lg fa-fw" />
                        </button>
                    </div>
                    <div>
                        <t t-call="argocd_website.external_links_dropdown">
                            <t t-set="class" t-value="'btn-light'" />
                        </t>
                    </div>
                </div>

                <div class="alert alert-info" t-if="message == 'request_deletion'">
                    <i class="fa fa-fw fa-info" /> Please check your email to confirm the deletion.
                </div>
                <div class="alert alert-info" t-if="message == 'pending_deletion'">
                    <i class="fa fa-fw fa-info" /> The deletion of this application is pending this can take a couple of minutes.
                </div>
                <div class="d-flex">
                    <div class="flex-fill">
                        <!-- Address -->
                        <strong class="d-block">Address: </strong>
                        <address t-field="app.partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "email"], "no_marker": True}'/>

                        <!-- Chamber of Commerce -->
                        <strong>Chamber of Commerce #:</strong>
                        <span t-field="app.partner_id.company_registry" />
                    </div>
                    <div t-if="app.domain_ids">
                        <strong>Health: </strong>
                        <span class="js_health_check" t-att-data-app-id="app.id">
                            <i class="fa fa-circle-o-notch fa-spin fa-fw" />
                        </span>
                    </div>
                </div>
                <div class="mt16" t-if="app.subscription_line_id">
                    <ul class="list-group mb-2">
                        <li class="list-group-item d-grid">
                            <div class="row">
                                <div class="col-xl-9 col-8 fw-bold" t-esc="app.subscription_line_id.product_id.name" />
                            </div>
                            <div class="row" t-foreach="app.subscription_line_id.product_id.product_template_variant_value_ids" t-as="variant">
                                <div class="col-xl-9 col-8">
                                    <span t-esc="variant.attribute_id.name" />:
                                    <span class="badge text-bg-light" t-esc="variant.name" />
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <t t-call="argocd_website.portal_application_upgrade_modal" />
        </t>
    </template>

    <template id="portal_application_upgrade_modal">
        <div class="modal fade" tabindex="-1" role="dialog" t-att-id="modalId or 'modalUpgrade'">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Upgrade application</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                    </div>
                    <div class="modal-body">
                        <p>
                            Upgrading applications is currently not automated,
                            please send an email to <a t-attf-href="mailto:#{env.company.email}"><t t-esc="env.company.email" /></a> with your request.
                        </p>
                        <p>
                            We'll contact you when we processed your request.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="error_page" name="Error">
        <t t-call="portal.portal_layout">
            <div class="col-12">
                <div class="alert alert-danger">
                    <t t-esc="message" />
                </div>
            </div>
        </t>
    </template>

    <template id="portal_application_domain_names_page" name="Domain Names">
        <t t-call="portal.portal_layout">
            <div class="col-12">
                <div class="d-flex w-100">
                    <h2 class="mb-0 flex-fill">
                        <span>
                            Configure domain names for <span t-field="app.name" />
                        </span>
                    </h2>

                    <b>Perform these steps:</b>
                    <ol>
                        <li>Purchase a domain name</li>
                        <li>Configure a <b>CNAME</b> record for your domain pointing to your instances (e.g. <b><t t-esc="app.format_domain()" /></b> for Odoo)</li>
                        <li>Insert your domain names below and verify them</li>
                        <li>Leave them empty to use the default domain names</li>
                    </ol>

                    <form method="POST">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>
                        <div class="js_domain_cname_check mb-3" t-att-data-app-id="app.id">
                            <label for="input_domain">Odoo</label>
                            <div class="input-group">
                                <input name="domain" id="input_domain" class="form-control" placeholder="e.g. www.example.com"
                                       t-att-value="defaults.get('domain', '')" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-outline-secondary">
                                        <i class="fa fa-check spinner-grow-sm ml4" />
                                        Verify
                                    </button>
                                </div>
                            </div>
                            <div class="text-success d-none"> <!-- valid-feedback and invalid-feedback is buggy with input group -->
                                Looks good!
                            </div>
                            <div class="text-danger d-none"></div>
                        </div>

                        <t t-foreach="app.tag_ids.filtered(lambda t: t.domain_yaml_path)" t-as="tag">
                            <div class="js_domain_cname_check mb-3" t-att-data-tag-id="tag.id" t-att-data-app-id="app.id">
                                <label t-attf-for="input_domain_#{tag.id}"><t t-esc="tag.name" /></label>
                                <div class="input-group">
                                    <input t-attf-name="domain_#{tag.id}" t-attf-id="input_domain_#{tag.id}"
                                           class="form-control" t-attf-placeholder="e.g. #{tag.key}.example.com"
                                           t-att-value="defaults.get('domain_%s' % tag.key, '')"
                                    />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary">
                                            <i class="fa fa-check spinner-grow-sm mr4" />
                                            Verify
                                        </button>
                                    </div>
                                </div>
                                <div class="text-success d-none">
                                    Looks good!
                                </div>
                                <div class="text-danger d-none"></div>
                            </div>
                        </t>
                        <p class="alert alert-info"> It can take a few minutes for the changes to take place</p>
                        <button class="btn btn-primary btn-lg">
                            Confirm
                        </button>
                    </form>

                </div>
            </div>
        </t>
    </template>

    <!-- Customer Portal Templates -->
    <template id="portal_my_customers" name="My Customers">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Customers</t>
            </t>
            <t t-if="customers" t-call="portal.portal_table">
                <t t-set="classes" t-value="'mb-2'" />
                <thead>
                    <tr class="active">
                        <th>Company Name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>CoC #</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="customers" t-as="customer">
                        <tr>
                            <td>
                                <a
                                    t-attf-href="/my/customers/#{customer.id}"
                                    t-att-title="customer.name"
                                >
                                    <t t-esc="customer.name" />
                                </a>
                            </td>
                            <td>
                                <t t-esc="customer.email" />
                            </td>
                            <td>
                                <t t-esc="customer.city" />
                            </td>
                            <td>
                                <t t-esc="customer.company_registry" />
                            </td>
                            <td class="text-end">
                                <a
                                    t-attf-href="/my/customers/#{customer.id}/edit"
                                    class="btn btn-sm btn-secondary"
                                    title="Edit"
                                >
                                    <i class="fa fa-edit" />
                                </a>
                                <form
                                    t-attf-action="/my/customers/#{customer.id}/archive"
                                    method="post"
                                    style="display: inline;"
                                    onsubmit="return confirm('Are you sure you want to archive this customer?');"
                                >
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-danger" title="Archive">
                                        <i class="fa fa-archive" />
                                    </button>
                                </form>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
            <t t-else="">
                <p>You have no customers currently.</p>
            </t>
            <div t-if="message == 'archived'" class="alert alert-success mt-3 mb-3">
                <i class="fa fa-check" /> Customer has been archived successfully.
            </div>
            <a href="/my/customers/create" class="btn btn-primary">
                Create Customer
            </a>
        </t>
    </template>

    <template id="portal_customer_detail" name="Customer Details">
        <t t-call="portal.portal_layout">
            <div class="col-12">
                <div class="d-flex mb-3">
                    <h2 class="mb-0 flex-fill">
                        <span t-esc="customer.name" />
                    </h2>
                    <div>
                        <a
                            t-attf-href="/my/customers/#{customer.id}/edit"
                            class="btn btn-primary"
                        >
                            <i class="fa fa-edit" /> Edit
                        </a>
                        <form
                            t-attf-action="/my/customers/#{customer.id}/archive"
                            method="post"
                            style="display: inline;"
                            onsubmit="return confirm('Are you sure you want to archive this customer?');"
                        >
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-danger">
                                <i class="fa fa-archive" /> Archive
                            </button>
                        </form>
                    </div>
                </div>

                <div t-if="message == 'created'" class="alert alert-success">
                    <i class="fa fa-check" /> Customer has been created successfully.
                </div>
                <div t-if="message == 'updated'" class="alert alert-success">
                    <i class="fa fa-check" /> Customer has been updated successfully.
                </div>
                <div t-if="message == 'has_active_subscriptions'" class="alert alert-danger">
                    <i class="fa fa-exclamation-triangle" /> Cannot archive customer with active subscriptions.
                </div>
                <div t-if="message == 'archive_error'" class="alert alert-danger">
                    <i class="fa fa-exclamation-triangle" /> An error occurred while archiving the customer.
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Contact Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Company Name:</strong>
                                <p t-esc="customer.name" />
                            </div>
                            <div class="col-md-6">
                                <strong>Email:</strong>
                                <p>
                                    <a t-attf-href="mailto:#{customer.email}" t-esc="customer.email" />
                                </p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Phone:</strong>
                                <p t-esc="customer.phone or '-'" />
                            </div>
                            <div class="col-md-6">
                                <strong>Chamber of Commerce #:</strong>
                                <p t-esc="customer.company_registry or '-'" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Address</h5>
                    </div>
                    <div class="card-body">
                        <address>
                            <t t-if="customer.street">
                                <t t-esc="customer.street" /><br/>
                            </t>
                            <t t-if="customer.street2">
                                <t t-esc="customer.street2" /><br/>
                            </t>
                            <t t-if="customer.zip or customer.city">
                                <t t-esc="customer.zip" /> <t t-esc="customer.city" /><br/>
                            </t>
                            <t t-if="customer.country_id">
                                <t t-esc="customer.country_id.name" />
                            </t>
                        </address>
                    </div>
                </div>

                <div class="card" t-if="subscriptions">
                    <div class="card-header">
                        <h5 class="mb-0">Subscriptions</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Stage</th>
                                    <th>Next Invoice Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="subscriptions" t-as="subscription">
                                    <tr>
                                        <td>
                                            <a t-attf-href="/my/subscriptions/#{subscription.id}" t-esc="subscription.name" />
                                        </td>
                                        <td>
                                            <span t-esc="subscription.stage_id.name" />
                                        </td>
                                        <td>
                                            <span t-field="subscription.recurring_next_date" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_customer_form" name="Customer Form">
        <t t-call="portal.portal_layout">
            <div class="col-12">
                <form method="POST" class="needs-validation">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div t-if="errors and errors.get('general')" class="alert alert-danger">
                        <t t-esc="errors.get('general')" />
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">General Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="name" class="form-label">Company Name <span class="fw-bold">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        t-attf-class="form-control #{errors.get('name') and 'is-invalid' or ''}"
                                        id="name"
                                        name="name"
                                        required="required"
                                        t-att-value="form_data.get('name', '')"
                                    />
                                    <div t-if="errors.get('name')" class="invalid-feedback d-block">
                                        <t t-esc="errors.get('name')" />
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label">Email <span class="fw-bold">*</span></label>
                                    <input
                                        type="email"
                                        class="form-control"
                                        t-attf-class="form-control #{errors.get('email') and 'is-invalid' or ''}"
                                        id="email"
                                        name="email"
                                        required="required"
                                        t-att-value="form_data.get('email', '')"
                                    />
                                    <div t-if="errors.get('email')" class="invalid-feedback d-block">
                                        <t t-esc="errors.get('email')" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="phone" class="form-label">Phone</label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="phone"
                                        name="phone"
                                        t-att-value="form_data.get('phone', '')"
                                    />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="company_registry" class="form-label">Chamber of Commerce # <span class="fw-bold">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        t-attf-class="form-control #{errors.get('company_registry') and 'is-invalid' or ''}"
                                        id="company_registry"
                                        name="company_registry"
                                        required="required"
                                        t-att-value="form_data.get('company_registry', '')"
                                    />
                                    <div t-if="errors.get('company_registry')" class="invalid-feedback d-block">
                                        <t t-esc="errors.get('company_registry')" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">Address</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="street" class="form-label">Street <span class="fw-bold">*</span></label>
                                <input
                                    type="text"
                                    class="form-control"
                                    t-attf-class="form-control #{errors.get('street') and 'is-invalid' or ''}"
                                    id="street"
                                    name="street"
                                    required="required"
                                    t-att-value="form_data.get('street', '')"
                                />
                                <div t-if="errors.get('street')" class="invalid-feedback d-block">
                                    <t t-esc="errors.get('street')" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="zip" class="form-label">ZIP <span class="fw-bold">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        t-attf-class="form-control #{errors.get('zip') and 'is-invalid' or ''}"
                                        id="zip"
                                        name="zip"
                                        required="required"
                                        t-att-value="form_data.get('zip', '')"
                                    />
                                    <div t-if="errors.get('zip')" class="invalid-feedback d-block">
                                        <t t-esc="errors.get('zip')" />
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="city" class="form-label">City <span class="fw-bold">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        t-attf-class="form-control #{errors.get('city') and 'is-invalid' or ''}"
                                        id="city"
                                        name="city"
                                        required="required"
                                        t-att-value="form_data.get('city', '')"
                                    />
                                    <div t-if="errors.get('city')" class="invalid-feedback d-block">
                                        <t t-esc="errors.get('city')" />
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="country_id" class="form-label">Country <span class="fw-bold">*</span></label>
                                    <select class="form-control" id="country_id" name="country_id">
                                        <option value="">Select a country</option>
                                        <t t-foreach="countries" t-as="country">
                                            <option
                                                t-att-value="country.id"
                                                t-att-selected="form_data.get('country_id') == country.id and 'selected' or None"
                                            >
                                                <t t-esc="country.name" />
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a t-attf-href="/my/customers#{customer and '/' + str(customer.id) or ''}" class="btn btn-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <t t-if="mode == 'create'">Create Customer</t>
                            <t t-else="">Save Changes</t>
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>

</odoo>
