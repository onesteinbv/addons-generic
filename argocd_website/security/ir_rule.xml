<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_portal_public_rule" model="ir.rule">
        <field name="name">product_portal_public_rule</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">
            [
                ('sale_ok', '=', True),
                ('application_template_id', '!=', False),
                '|', '|',
                ('reseller_partner_ids', '=', False),
                ('reseller_partner_ids', 'in', [user.partner_id.id]),
                ('reseller_partner_ids', 'in', [user.partner_id.parent_id.id]),
            ]
        </field>
        <field name="groups" eval="[Command.link(ref('base.group_portal')), Command.link(ref('base.group_public'))]"/>
    </record>

    <record id="product_template_portal_public_rule" model="ir.rule">
        <field name="name">product_template_portal_public_rule</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">
            [
                ('sale_ok', '=', True),
                ('application_template_id', '!=', False),
                '|', '|',
                ('reseller_partner_ids', '=', False),
                ('reseller_partner_ids', 'in', [user.partner_id.id]),
                ('reseller_partner_ids', 'in', [user.partner_id.parent_id.id]),
            ]
        </field>
        <field name="groups" eval="[Command.link(ref('base.group_portal')), Command.link(ref('base.group_public'))]"/>
    </record>

    <record id="argocd_application_portal_rule" model="ir.rule">
        <field name="name">argocd_application_portal_access</field>
        <field name="model_id" ref="argocd_deployer.model_argocd_application"/>
        <field name="domain_force">
            [
                '|', '|', '|',
                ('partner_id', '=', user.partner_id.id),
                ('partner_id', 'child_of', user.partner_id.id),
                ('partner_id.reseller_id', '=', user.partner_id.id),
                ('partner_id.reseller_id', '=', user.partner_id.parent_id.id),
            ]
        </field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>

    <record id="argocd_application_domain_portal_rule" model="ir.rule">
        <field name="name">argocd_application_domain_portal_rule</field>
        <field name="model_id" ref="argocd_deployer.model_argocd_application_domain"/>
        <field name="domain_force">
            [
                '|', '|', '|',
                ('application_id.partner_id', '=', user.partner_id.id),
                ('application_id.partner_id', 'child_of', user.partner_id.id),
                ('application_id.partner_id.reseller_id', '=', user.partner_id.id),
                ('application_id.partner_id.reseller_id', '=', user.partner_id.parent_id.id),
            ]
        </field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>

    <!-- Reseller customer access rules -->
    <record id="res_partner_portal_reseller_customer_read" model="ir.rule">
        <field name="name">res_partner_portal_reseller_customer_read</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">
            [
                ('reseller_id', '!=', False),
                '|',
                ('reseller_id', '=', user.partner_id.id),
                ('reseller_id', '=', user.partner_id.parent_id.id),
            ]
        </field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="res_partner_portal_reseller_customer_write" model="ir.rule">
        <field name="name">res_partner_portal_reseller_customer_write</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">
            [
                ('reseller_id', '!=', False),
                '|',
                ('reseller_id', '=', user.partner_id.id),
                ('reseller_id', '=', user.partner_id.parent_id.id),
            ]
        </field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
