<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Snippet Template -->
    <template id="s_membership_members" name="Members">
        <section class="s_membership_members pt32 pb32" data-group-id="">
            <div class="container">
                <div class="row s_nb_column_fixed">
                    <div class="col-12">
                        <h3 class="mb-3">Members</h3>
                        <div class="s_membership_members_container">
                            <div class="text-muted">Select a membership group in the snippet options.</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Register Snippet in Panel -->
    <template id="snippets" inherit_id="website.snippets">
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t t-snippet="website_membership_snippet.s_membership_members" 
               string="Members" 
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_company_team.svg"/>
        </xpath>
    </template>

    <!-- Snippet Options -->
    <template id="s_membership_members_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="MembershipSnippetOptions" data-selector=".s_membership_members">
                <we-select string="Membership Group" data-name="group_id_opt" data-attribute-name="groupId" data-no-preview="true">
                </we-select>
                <we-select string="Layout" data-name="layout_opt" data-attribute-name="layout" data-no-preview="true">
                    <we-button data-select-data-attribute="grid" title="Grid">Grid</we-button>
                    <we-button data-select-data-attribute="list" title="List">List</we-button>
                    <we-button data-select-data-attribute="avatars" title="Avatars">Avatars</we-button>
                </we-select>
            </div>
        </xpath>
    </template>
</odoo>