<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rgs</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="41" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='chart_template']/.." position="after">
                <div class="row mt16" invisible="not is_l10n_nl_rgs">
                    <field name="is_l10n_nl_rgs" invisible="1" />
                    <label
                        for="l10n_nl_rgs_disable_allowed_journals"
                        string="Disable allowed journals"
                        class="col-2 o_light_label"
                    />
                    <field
                        name="l10n_nl_rgs_disable_allowed_journals"
                        class="oe_inline"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
