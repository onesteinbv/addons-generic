<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="application_form" model="ir.ui.view">
        <field name="model">argocd.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="render_config"
                        type="object"
                        class="btn-secondary"
                        icon="fa-refresh"
                        string="Render Config"
                    />
                    <button
                        name="immediate_deploy"
                        type="object"
                        string="Deploy"
                        class="btn-success"
                        invisible="not is_immediate_repo_action_visible or not application_set_id or is_deployed"
                    />
                    <button
                        name="immediate_deploy"
                        type="object"
                        string="Redeploy"
                        class="btn-warning"
                        invisible="not is_immediate_repo_action_visible or not application_set_id or not is_deployed"
                        confirm="Are you sure you want to redeploy this application?"
                    />
                    <button
                        name="deploy"
                        type="object"
                        string="Queue deployment"
                        class="btn-success"
                        invisible="not application_set_id or is_deployed"
                    />
                    <button
                        name="deploy"
                        type="object"
                        string="Queue redeployment"
                        class="btn-warning"
                        invisible="not application_set_id or not is_deployed"
                        confirm="Are you sure you want to redeploy this application?"
                    />
                    <button
                        name="immediate_destroy"
                        type="object"
                        class="btn-danger"
                        string="Destroy"
                        confirm="Are you sure you want to destroy this application? This can't be undone."
                        invisible="not is_immediate_repo_action_visible or not application_set_id or not is_deployed"
                    />
                    <button
                        name="destroy"
                        type="object"
                        class="btn-danger"
                        string="Queue destruction"
                        confirm="Are you sure you want to destroy this application? This can't be undone."
                        invisible="not application_set_id or not is_deployed"
                    />
                    <field name="description" class="pull-right"/> <!-- Move when this field is used for more than only urls -->
                </header>
                <sheet>
                    <field name="is_deployed" invisible="1"/>
                    <field name="is_immediate_repo_action_visible" invisible="1"/>
                    <group>
                        <group string="General information">
                            <field
                                name="name"
                                readonly="is_deployed"
                            />
                            <field name="application_set_id"
                                   readonly="is_deployed"
                            />
                        </group>
                        <group string="Customizations">
                            <field name="template_id" />
                            <field name="tag_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                            <field name="value_ids" />
                            <field name="domain_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="scope_id" />
                                    <field name="name" />
                                </list>
                            </field>
                        </group>
                    </group>
                    <group string="YAML Configuration" col="3">
                        <group string="Live">
                            <field name="config_live" widget="ace" nolabel="1" />
                        </group>
                        <group string="Desired">
                            <field name="config" widget="ace" nolabel="1" />
                        </group>
                        <group string="Diff">
                            <field name="config_diff" widget="ace" nolabel="1" />
                        </group>
                    </group>
                    <group string="Statistics">
                        <field name="stat_ids" nolabel="1" colspan="2" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="application_search" model="ir.ui.view">
        <field name="model">argocd.application</field>
        <field name="arch" type="xml">
            <search string="Applications">
                <field name="name" />
                <field name="application_set_id" />
                <field name="template_id" />
                <field name="tag_ids" />

                <filter name="deployed_applications" string="Deployed" domain="[('is_deployed', '=', True)]"/>
                <filter name="not_deployed_applications" string="Not Deployed" domain="[('is_deployed', '!=', True)]"/>
                <filter name="out_of_sync_applications" string="Out of Sync" domain="[('config_out_of_sync', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="application_tree" model="ir.ui.view">
        <field name="model">argocd.application</field>
        <field name="arch" type="xml">
            <list decoration-success="is_deployed"
                  decoration-warning="not is_deployed"
            >
                <field
                    name="config_diff"
                    widget="popover"
                    icon="fa-exclamation-triangle"
                    class="text-danger"
                    invisible="not config_out_of_sync"
                    nolabel="1"
                />
                <field name="is_deployed" column_invisible="1"/>
                <field name="name" />
                <field name="application_set_id" />
                <field name="template_id" />
                <field name="create_date" />
                <field name="tag_ids" widget="many2many_tags" />
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="application_action" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">argocd.application</field>
        <field name="view_mode">list,form</field>
        <field name="path">applications</field>
    </record>

    <record id="application_render_config_action" model="ir.actions.server">
        <field name="name">Render Config</field>
        <field name="model_id" ref="argocd_deployer.model_argocd_application"/>
        <field name="binding_model_id" ref="argocd_deployer.model_argocd_application"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.render_config()</field>
    </record>

    <record id="application_queue_redeployment_action" model="ir.actions.server">
        <field name="name">Queue Deployment / Redeployment</field>
        <field name="model_id" ref="argocd_deployer.model_argocd_application"/>
        <field name="binding_model_id" ref="argocd_deployer.model_argocd_application"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.deploy()</field>
    </record>
</odoo>
