<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="application_domain_scope_tree" model="ir.ui.view">
        <field name="model">argocd.application.domain.scope</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="application_domain_scope_form" model="ir.ui.view">
        <field name="model">argocd.application.domain.scope</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="application_domain_scope_action" model="ir.actions.act_window">
        <field name="name">Domain Scopes</field>
        <field name="res_model">argocd.application.domain.scope</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
