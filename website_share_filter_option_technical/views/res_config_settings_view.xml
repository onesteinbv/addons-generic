<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="after">
                <block title="Social Media" id="website_social_media_settings" invisible="not website_id">
                    <span class="o_form_label">Share Buttons</span>
                    <div class="text-muted">
                        Select which share options you want to allow
                    </div>
                    <setting id="website_share_twitter">
                        <field name="website_share_twitter" string="Twitter"/>
                    </setting>
                    <setting id="website_share_facebook">
                        <field name="website_share_facebook" string="Facebook"/>
                    </setting>
                    <setting id="website_share_whatsapp">
                        <field name="website_share_whatsapp" string="Whatsapp"/>
                    </setting>
                    <setting id="website_share_linkedin">
                        <field name="website_share_linkedin" string="LinkedIn"/>
                    </setting>
                    <setting id="website_share_pinterest">
                        <field name="website_share_pinterest" string="Pinterest"/>
                    </setting>
                    <setting id="website_share_email">
                        <field name="website_share_email" string="Email"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
