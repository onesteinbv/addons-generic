<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_share_buttons" inherit_id="website_sale.product_share_buttons">
        <xpath expr="//a[hasclass('s_share_email')]" position="before">
            <a t-if="not _exclude_share_links or not 'pleroma' in _exclude_share_links" href="/share/getDomain?url={url}&amp;media={media}&amp;title={title}&amp;platform=pleroma" class="s_share_pleroma" target="_blank" aria-label="Pleroma">
                <img src="/website_sale_share_pleroma/static/img/icons/pleroma.svg" class="fa social-media-icon rounded shadow-sm" alt="social-media-icon"/>
            </a>
        </xpath>
    </template>

    <record id="s_share_000_scss" model="ir.asset">
        <field name="name">Share Pleroma 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">website_sale_share_pleroma/static/src/snippets/s_share/000.scss</field>
    </record>

</odoo>
