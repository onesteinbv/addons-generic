<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Reseller fields -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_reseller" invisible="reseller_id or parent_id" />
                <field name="reseller_id" invisible="is_reseller or parent_id" />
            </xpath>

            <!-- Reseller settings -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Reseller" name="reseller" invisible="not is_reseller">
                    <group>
                        <field name="reseller_partner_ids" />
                        <field
                            name="reselling_product_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <filter
                    string="Resellers"
                    name="resellers"
                    domain="[('is_reseller', '=', True)]"
                />
            </xpath>
        </field>
    </record>

    <record id="reseller_action" model="ir.actions.act_window">
        <field name="name">Resellers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field
            name="context"
        >{'default_is_reseller': True, 'search_default_resellers': True}</field>
    </record>

    <menuitem
        id="reseller_menu"
        parent="argocd_deployer.argocd_root_menu"
        action="reseller_action"
        sequence="35"
    />
</odoo>
