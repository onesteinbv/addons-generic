<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='catalog_setting_container']" position="after">
                <block title="Applications" name="applications_container">
                    <setting id="grace_period_settings">
                        <div class="content-group">
                            <label
                                string="Termination"
                                for="subscription_grace_period"
                            />
                            <div class="text-muted">
                                Confihgure what happens to applications when the related subscription is expired or ended.
                            </div>
                            <div class="content-group">
                                <span class="fw-bold">Grace period: </span><field
                                name="subscription_grace_period"
                                class="oe_inline"
                            /> days
                                <span class="text-muted">
                                    (set to 0 to disable it)
                                </span>

                                <span class="fw-bold">Action: </span><field
                                name="subscription_termination_action"
                                class="oe_inline"
                            />
                                <field
                                name="subscription_termination_tag_id"
                                options="{'no_create':True}"
                                invisible="subscription_termination_action != 'add_tag'"
                                class="oe_inline ml4"
                            />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
