<odoo>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_nickname.view_partner_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='nickname']" position="attributes">
                <attribute name="attrs">{'required': [('website_privacy', '=', 'nickname')]}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">Partner Website Privacy</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_nickname.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='nickname']" position="attributes">
                <attribute name="attrs">{'required': [('website_privacy', '=', 'nickname')]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
