<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_membership_history_wizard_form" model="ir.ui.view">
        <field name="name">membership.history.wizard.form</field>
        <field name="model">membership.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Choose your date">
                <group>
                    <field name="date" />
                    <field name="only_voting_members" />
                    <field name="group_ids" widget="many2many_tags"
                        invisible="only_voting_members"
                        options="{'no_create': True}" />
                </group>
                <footer>
                    <button name="open_at_date" string="Confirm" type="object" class="btn-primary"
                        data-hotkey="q" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
